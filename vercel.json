{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "backend/api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "backend/api/index.ts"
    },
    {
      "source": "/((?!api|assets|favicon.ico|.*\\..*).*)",
      "destination": "frontend/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "frontend/$1"
    }
  ]
}
