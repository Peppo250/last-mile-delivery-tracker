# ---- Server ----------------------------------------------------------
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ---- Database ----------------------------------------------------------
# SQLite (default, zero setup):
DATABASE_URL="file:./dev.db"
# PostgreSQL (production — Render/Railway/Supabase etc.), and remember to
# also change `provider = "postgresql"` in prisma/schema.prisma:
# DATABASE_URL="postgresql://user:password@host:5432/delivery_tracker"

# ---- Auth ----------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Email (optional — leave blank to skip real sending and only log) ---
# Works with any SMTP provider on a free tier, e.g. Gmail (with an App
# Password), Mailtrap, Brevo (Sendinblue), or Ethereal for testing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Last-Mile Delivery <no-reply@delivery.local>"

# ---- SMS (optional — leave blank to skip and only log) ---------------
# Wire up a provider such as Twilio's free trial in
# src/services/notificationService.ts -> sendSms().
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=
